      "parameters": {
        "jsCode": "const postedRows = $input.all();\nconst postedTitles = new Set(postedRows.map(r => r.json.item_id));\n\nconst rssItems = $('RSS Read3').all();\nconst newItems = rssItems.filter(i => !postedTitles.has(i.json.title));\n\nreturn newItems.map(i => ({ json: i.json }));"
