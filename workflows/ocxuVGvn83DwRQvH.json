    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('node');\nconst lastSeen = staticData.lastSeen ? new Date(staticData.lastSeen) : new Date(0);\n\nconst items = $input.all();\n\nconst newItems = items.filter(i => new Date(i.json.pubDate) > lastSeen);\n\nif (items.length) {\n  staticData.lastSeen = new Date(\n    Math.max(...items.map(i => new Date(i.json.pubDate).getTime()))\n  ).toISOString();\n}\n\nreturn newItems;"
      },
